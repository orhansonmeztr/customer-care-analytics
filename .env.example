# Copy to .env and fill in. .env is git-ignored.
# The default provider is the local GPU node (data stays in the network):
#   kubectl -n llm port-forward svc/vllm-coder 18001:8000
ASSISTANT_PROVIDER=vllm
VLLM_BASE_URL=http://localhost:18001/v1
VLLM_MODEL=qwen2.5-coder-14b

# DeepSeek, most accurate, data leaves the network (care ask ... --provider deepseek)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# Any other OpenAI-compatible endpoint (care ask ... --provider openai)
# ASSISTANT_BASE_URL=
# ASSISTANT_MODEL=
# ASSISTANT_API_KEY=
